# Copia este archivo como .env y rellena tus propios valores.
# .env nunca se sube al repositorio (está en .gitignore).

# Credenciales del panel de administración (HTTP Basic Auth)
ADMIN_USER=cambia_este_usuario
ADMIN_PASSWORD=cambia_esta_contraseña

# Bot de Telegram para las notificaciones de nuevas reservas.
# Crea un bot con @BotFather y consigue tu chat_id con @userinfobot.
TELEGRAM_BOT_TOKEN=tu_token_de_telegram
TELEGRAM_CHAT_ID=tu_chat_id

# Solo en producción (Render u otro hosting): URL de la base de datos.
# En local se omite y se usa automáticamente sqlite:///./barberia.db
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd

# Dominio(s) desde los que se permite llamar a la API (separados por
# comas si hay varios). En local se omite: por defecto ya acepta
# http://127.0.0.1:8000 y http://localhost:8000.
# ALLOWED_ORIGINS=https://tu-dominio-en-produccion.com